# Copy this file to .env and set DASHBOARD_PIN before first use.
DASHBOARD_PIN=ChangeThisPIN123
# Optional: if missing or shorter than 24 characters, a random secret is generated once in data/session.secret.
#SESSION_SECRET=replace-with-a-long-random-secret-of-24+-chars
# PORT=auto picks a random high port (49152-65535) once and remembers it in data/port. Or set a fixed number, e.g. 8080.
PORT=auto
